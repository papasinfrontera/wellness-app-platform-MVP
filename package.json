  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:pilot && npm run test:catalog128 && npm run test:audit && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "catalog:refresh": "node scripts/extract-public-reference-catalog.mjs",
