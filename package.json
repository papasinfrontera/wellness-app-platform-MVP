    "test:catalog": "node --test tests/indicator-batch-16.test.mjs",
    "test:catalog32": "node --test tests/indicator-batch-32.test.mjs",
    "test:catalog48": "node --test tests/indicator-batch-48.test.mjs",
    "test:catalog64": "node --test tests/indicator-batch-64.test.mjs",
    "test:catalog80": "node --test tests/indicator-batch-80.test.mjs",
    "test:catalog96": "node --test tests/indicator-batch-96.test.mjs",
    "test:catalog112": "node --test tests/indicator-batch-112.test.mjs",
    "test:catalog128": "node --test tests/indicator-batch-128.test.mjs",
    "test:audit": "node --test tests/indicator-terminology-audit.test.mjs",
    "audit:catalog": "node scripts/audit-indicator-catalog.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
